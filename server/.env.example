PORT=5000
BACKEND_URL=http://localhost:5000
JWT_SECRET=replace_with_local_secret

FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Optional for hosted deployments. Use this instead of FIREBASE_SERVICE_ACCOUNT_PATH when the JSON file is not available.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

CLICKSEND_USERNAME=your_clicksend_username
CLICKSEND_API_KEY=your_clicksend_api_key

# Demo seeding is opt-in and never runs when NODE_ENV=production.
# Leave false unless this points at a local database you are happy to overwrite.
SEED_DEMO_DATA=false

# Company Admin bootstrap (used by: npm run seed:company-admin)
# No other seed script creates a Company Admin account.
COMPANY_ADMIN_EMAIL=admin@example.com
COMPANY_ADMIN_PASSWORD=choose_a_local_password
COMPANY_ADMIN_NAME=Company Admin
